<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="[%d{yyyy-MM-dd HH:mm:ss}] [%marker] %msg%n"/>
        </Console>
        <File name="GameLog" fileName="logs/game.log">
            <PatternLayout pattern="[%d{yyyy-MM-dd HH:mm:ss}] [%marker] %msg%n"/>
        </File>
    </Appenders>
    <Loggers>
        <Logger name="com.mario" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="GameLog"/>
        </Logger>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
